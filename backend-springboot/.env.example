# Backend Local Environment Variables (copy thành backend-springboot/.env để ghi đè không đẩy lên Git)

# Google OAuth2 Client ID (dùng chung với frontend-web/.env và mobile-android strings.xml)
GOOGLE_CLIENT_ID=226507914034-rjm7n0fcnucpb3sakg5q6kk8gbrs8hcf.apps.googleusercontent.com

# Gmail SMTP để gửi OTP Quên mật khẩu thật
# Lưu ý: Với Gmail, dùng App Password 16 ký tự (Google Account -> Security -> 2-Step Verification -> App passwords)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-app-password
