<resources>
    <style name="Theme.SmartFlash" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/quizlet_blue</item>
        <item name="colorOnPrimary">@color/quizlet_card</item>
        <item name="android:colorBackground">@color/white</item>
        <item name="colorSurface">@color/quizlet_card</item>
        <item name="colorOnSurface">@color/quizlet_text_dark</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/sf_bg_screen</item>
        <item name="android:navigationBarColor">@color/sf_bg_screen</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.SmartFlash.Splash" parent="Theme.SmartFlash">
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="SmartFlash.TextInputLayout" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">#F4F4F9</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="boxCornerRadiusTopStart">10.5dp</item>
        <item name="boxCornerRadiusTopEnd">10.5dp</item>
        <item name="boxCornerRadiusBottomStart">10.5dp</item>
        <item name="boxCornerRadiusBottomEnd">10.5dp</item>
        <item name="hintEnabled">false</item>
        <item name="errorEnabled">false</item>
    </style>

    <style name="SmartFlash.BottomNavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">#EBECEF</item>
        <item name="android:width">64dp</item>
        <item name="android:height">42dp</item>
    </style>
    <style name="SmartFlash.SearchTabText" parent="TextAppearance.Design.Tab">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14.5sp</item>
        <item name="textAllCaps">false</item>
    </style>
</resources>
