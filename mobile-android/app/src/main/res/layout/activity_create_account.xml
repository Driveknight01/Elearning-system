<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sv_create_account"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="28dp">

        <!-- Top Back Arrow (>=48dp touch target) -->
        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="-12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_register"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back" />

        <!-- Bold Left-Aligned Title (matching Image 2) -->
        <TextView
            android:id="@+id/tv_create_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.01"
            android:text="@string/action_register"
            android:textColor="#282E3E"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Error Banner -->
        <TextView
            android:id="@+id/tv_error_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@color/quizlet_red_light"
            android:fontFamily="sans-serif-medium"
            android:padding="12dp"
            android:textColor="@color/quizlet_red"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Role Segmented Toggle: Học viên / Giáo viên (#F4F4F9 gray container) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_segmented_container"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/card_role_user"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_segmented_active"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:minHeight="48dp"
                android:text="@string/role_learner"
                android:textColor="#282E3E"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/card_role_teacher"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:minHeight="48dp"
                android:text="@string/role_teacher"
                android:textColor="@color/quizlet_text_muted"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Full Name Input -->
        <FrameLayout
            android:id="@+id/fl_full_name_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_quizlet_input_normal"
            android:padding="1.5dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_full_name"
                style="@style/SmartFlash.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_full_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:hint="@string/hint_full_name"
                    android:imeOptions="actionNext"
                    android:inputType="textPersonName"
                    android:letterSpacing="-0.01"
                    android:maxLines="1"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="16dp"
                    android:textColor="#282E3E"
                    android:textColorHint="#8A94AE"
                    android:textSize="15.5sp" />
            </com.google.android.material.textfield.TextInputLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/tv_full_name_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="4dp"
            android:textColor="#B91C1C"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Username Input -->
        <FrameLayout
            android:id="@+id/fl_username_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_quizlet_input_normal"
            android:padding="1.5dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_username"
                style="@style/SmartFlash.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_username"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:hint="@string/hint_username_short"
                    android:imeOptions="actionNext"
                    android:inputType="textNoSuggestions"
                    android:letterSpacing="-0.01"
                    android:maxLines="1"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="16dp"
                    android:textColor="#282E3E"
                    android:textColorHint="#8A94AE"
                    android:textSize="15.5sp" />
            </com.google.android.material.textfield.TextInputLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/tv_username_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="4dp"
            android:textColor="#B91C1C"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Email Input -->
        <FrameLayout
            android:id="@+id/fl_email_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_quizlet_input_normal"
            android:padding="1.5dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_email"
                style="@style/SmartFlash.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:hint="@string/hint_email"
                    android:imeOptions="actionNext"
                    android:inputType="textEmailAddress"
                    android:letterSpacing="-0.01"
                    android:maxLines="1"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="16dp"
                    android:textColor="#282E3E"
                    android:textColorHint="#8A94AE"
                    android:textSize="15.5sp" />
            </com.google.android.material.textfield.TextInputLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/tv_email_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="4dp"
            android:textColor="#B91C1C"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Password Input -->
        <FrameLayout
            android:id="@+id/fl_password_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_quizlet_input_normal"
            android:padding="1.5dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_password"
                style="@style/SmartFlash.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:endIconMode="password_toggle"
                app:endIconTint="#586380">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:hint="@string/hint_password"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:letterSpacing="-0.01"
                    android:maxLines="1"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="16dp"
                    android:textColor="#282E3E"
                    android:textColorHint="#8A94AE"
                    android:textSize="15.5sp" />
            </com.google.android.material.textfield.TextInputLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/tv_password_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="4dp"
            android:textColor="#B91C1C"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Terms Notice -->
        <TextView
            android:id="@+id/tv_terms_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="@string/register_terms_notice"
            android:textColor="#586380"
            android:textSize="12sp" />

        <!-- Create Account Pill Button (#F4F4F9 gray + muted text #C8CEDE when incomplete) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_create_account"
            style="@style/Widget.Material3.Button.UnelevatedButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="18dp"
            android:backgroundTint="#F4F4F9"
            android:fontFamily="sans-serif-medium"
            android:text="@string/action_register"
            android:textAllCaps="false"
            android:textColor="#C8CEDE"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="28dp" />

        <ProgressBar
            android:id="@+id/pb_create_loading"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
