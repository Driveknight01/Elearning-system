<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="18dp"
    android:paddingBottom="10dp">

    <EditText
        android:id="@+id/et_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@null"
        android:hint="Subject, chapter, unit"
        android:imeOptions="actionNext"
        android:inputType="textCapSentences"
        android:maxLines="2"
        android:paddingVertical="8dp"
        android:textColor="@color/sf_text_primary"
        android:textColorHint="@color/sf_hint_light"
        android:textSize="17sp" />

    <View
        android:id="@+id/view_title_underline"
        android:layout_width="match_parent"
        android:layout_height="1.5dp"
        android:background="@color/sf_underline_idle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:letterSpacing="0.06"
        android:text="TITLE"
        android:textColor="@color/sf_text_secondary"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- Optional Description container (toggled by + Description) -->
    <LinearLayout
        android:id="@+id/layout_description_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical"
        android:visibility="gone">

        <EditText
            android:id="@+id/et_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:hint="What's your set about?"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4"
            android:paddingVertical="6dp"
            android:textColor="@color/sf_text_primary"
            android:textColorHint="@color/sf_hint_light"
            android:textSize="15sp" />

        <View
            android:id="@+id/view_desc_underline"
            android:layout_width="match_parent"
            android:layout_height="1.5dp"
            android:background="@color/sf_underline_idle" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:letterSpacing="0.06"
            android:text="DESCRIPTION"
            android:textColor="@color/sf_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Action row: Scan document [lock badge] | + Description -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/btn_scan_document"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="6dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Scan document"
                android:src="@drawable/ic_scan_document" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Scan document"
                android:textColor="@color/quizlet_blue"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btn_add_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="4dp"
            android:paddingVertical="6dp"
            android:text="+ Description"
            android:textColor="@color/quizlet_blue"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
