<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sf_bg_screen"
    android:orientation="vertical">

    <!-- Top Bar: X + "Thẻ mới" + Checkmark (Image 6) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp">

        <ImageButton
            android:id="@+id/btn_tag_close"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Đóng"
            android:padding="12dp"
            android:src="@drawable/ic_close"
            app:tint="@color/sf_text_secondary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif"
            android:text="Thẻ mới"
            android:textColor="@color/sf_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_tag_confirm"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:alpha="0.35"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Lưu thẻ"
            android:enabled="false"
            android:padding="12dp"
            android:src="@drawable/ic_check"
            app:tint="@color/sf_text_secondary" />
    </LinearLayout>

    <EditText
        android:id="@+id/et_tag_name"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_search_pill"
        android:fontFamily="sans-serif-medium"
        android:hint="Tên thẻ"
        android:imeOptions="actionDone"
        android:inputType="text"
        android:maxLines="1"
        android:paddingHorizontal="18dp"
        android:textColor="@color/sf_text_primary"
        android:textColorHint="@color/sf_text_secondary"
        android:textSize="15.5sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="28dp"
        android:fontFamily="sans-serif"
        android:text="Đề xuất"
        android:textColor="@color/sf_text_secondary"
        android:textSize="13.5sp"
        android:textStyle="bold" />

    <!-- Recommended Tag Chips (Image 6) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_tag_1"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_library_pill_inactive"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:text="Exam 1"
                android:textColor="@color/sf_text_primary"
                android:textSize="14.5sp" />

            <TextView
                android:id="@+id/chip_tag_2"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:background="@drawable/bg_library_pill_inactive"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:text="Exam 2"
                android:textColor="@color/sf_text_primary"
                android:textSize="14.5sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_tag_3"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_library_pill_inactive"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:text="Midterm"
                android:textColor="@color/sf_text_primary"
                android:textSize="14.5sp" />

            <TextView
                android:id="@+id/chip_tag_4"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:background="@drawable/bg_library_pill_inactive"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:text="Final exam"
                android:textColor="@color/sf_text_primary"
                android:textSize="14.5sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_tag_5"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_library_pill_inactive"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:text="Quiz 1"
                android:textColor="@color/sf_text_primary"
                android:textSize="14.5sp" />

            <TextView
                android:id="@+id/chip_tag_6"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:background="@drawable/bg_library_pill_inactive"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:text="Unit 1"
                android:textColor="@color/sf_text_primary"
                android:textSize="14.5sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
