<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sv_reset_password"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/ll_reset_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="28dp">

        <!-- Top Back Arrow (matching Image 1) -->
        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="-12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_back"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back" />

        <!-- Bold Left-Aligned Title (matching Image 1) -->
        <TextView
            android:id="@+id/tv_reset_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.01"
            android:text="@string/reset_password_title"
            android:textColor="#282E3E"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Description Paragraph (matching Image 1) -->
        <TextView
            android:id="@+id/tv_reset_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="4dp"
            android:text="@string/reset_password_desc"
            android:textColor="#586380"
            android:textSize="15sp" />

        <!-- Error Banner -->
        <TextView
            android:id="@+id/tv_error_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/quizlet_red_light"
            android:fontFamily="sans-serif-medium"
            android:padding="12dp"
            android:textColor="@color/quizlet_red"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Success / Info Banner (shown after OTP is sent) -->
        <TextView
            android:id="@+id/tv_status_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/quizlet_blue_light"
            android:fontFamily="sans-serif-medium"
            android:padding="12dp"
            android:textColor="@color/quizlet_blue"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Email Input Box (matching LoginActivity textbox style) -->
        <FrameLayout
            android:id="@+id/fl_email_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_quizlet_input_normal"
            android:padding="1.5dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_email"
                style="@style/SmartFlash.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:hint="@string/hint_email"
                    android:imeOptions="actionDone"
                    android:inputType="textEmailAddress"
                    android:letterSpacing="-0.01"
                    android:maxLines="1"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="16dp"
                    android:textColor="#282E3E"
                    android:textColorHint="#8A94AE"
                    android:textSize="15.5sp" />
            </com.google.android.material.textfield.TextInputLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/tv_email_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="4dp"
            android:textColor="#B91C1C"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Step 2: OTP + New Password (revealed smoothly after OTP is sent) -->
        <LinearLayout
            android:id="@+id/ll_step2_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/fl_otp_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_quizlet_input_normal"
                android:padding="1.5dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_otp"
                    style="@style/SmartFlash.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_otp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:hint="Mã OTP (6 số)"
                        android:imeOptions="actionNext"
                        android:inputType="number"
                        android:letterSpacing="-0.01"
                        android:maxLength="6"
                        android:maxLines="1"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="16dp"
                        android:textColor="#282E3E"
                        android:textColorHint="#8A94AE"
                        android:textSize="15.5sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/tv_otp_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="4dp"
                android:textColor="#B91C1C"
                android:textSize="13sp"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/fl_new_password_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_quizlet_input_normal"
                android:padding="1.5dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_new_password"
                    style="@style/SmartFlash.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:endIconMode="password_toggle"
                    app:endIconTint="#586380">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_new_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:hint="Mật khẩu mới (tối thiểu 6 ký tự)"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:letterSpacing="-0.01"
                        android:maxLines="1"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="16dp"
                        android:textColor="#282E3E"
                        android:textColorHint="#8A94AE"
                        android:textSize="15.5sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/tv_new_password_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="4dp"
                android:textColor="#B91C1C"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_resend_otp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="8dp"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:paddingVertical="6dp"
                android:text="@string/action_resend_otp"
                android:textColor="@color/quizlet_blue"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Pill Action Button (Gray disabled like Image 1 -> Blue active when valid) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_submit_reset"
            style="@style/Widget.Material3.Button.UnelevatedButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#F4F4F9"
            android:enabled="false"
            android:fontFamily="sans-serif-medium"
            android:text="@string/action_send_otp"
            android:textAllCaps="false"
            android:textColor="#B8C0D2"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="28dp" />

        <ProgressBar
            android:id="@+id/pb_reset_loading"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="14dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
