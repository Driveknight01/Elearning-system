<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sv_register"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="18dp"
        android:paddingBottom="28dp">

        <!-- Top-left Brand Logo & Name (matching Image 1) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="4dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="ELearner"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_elearner_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="@font/plus_jakarta_sans_semibold"
                android:letterSpacing="-0.01"
                android:text="ELearner"
                android:textColor="#282E3E"
                android:textSize="19sp" />
        </LinearLayout>

        <!-- Centered Hero + Buttons Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="12dp">

            <!-- Circular Q-shaped Hero Frame with User's Photo -->
            <ImageView
                android:id="@+id/iv_register_hero"
                android:layout_width="224dp"
                android:layout_height="216dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/img_register_hero" />

            <!-- Bold Centered Headline -->
            <TextView
                android:id="@+id/tv_register_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="@string/register_hero_headline"
                android:textColor="#282E3E"
                android:textSize="25sp"
                android:textStyle="bold" />

            <!-- Terms Notice -->
            <TextView
                android:id="@+id/tv_terms_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/register_terms_notice"
                android:textColor="#586380"
                android:textSize="13sp" />

            <!-- Error Banner -->
            <TextView
                android:id="@+id/tv_error_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@color/quizlet_red_light"
                android:fontFamily="sans-serif-medium"
                android:padding="12dp"
                android:textColor="@color/quizlet_red"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Method 1: Continue with Google (Blue Pill) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_google_register"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/quizlet_blue"
                android:fontFamily="sans-serif-medium"
                android:text="@string/action_continue_google"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_google_g_white"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconTint="@color/white" />

            <!-- Method 2: Sign up with Email (Soft Blue Pill) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_email_register"
                style="@style/Widget.Material3.Button.UnelevatedButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/quizlet_blue_light"
                android:fontFamily="sans-serif-medium"
                android:text="@string/action_signup_email"
                android:textAllCaps="false"
                android:textColor="@color/quizlet_blue"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_email"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconTint="@color/quizlet_blue" />

            <ProgressBar
                android:id="@+id/pb_register_loading"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <!-- Bottom Link: Have an account? Log in -->
            <LinearLayout
                android:id="@+id/tab_go_login"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="48dp"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/register_have_account"
                    android:textColor="#282E3E"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/tab_login"
                    android:textColor="@color/quizlet_blue"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
