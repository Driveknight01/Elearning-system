<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:outlineAmbientShadowColor="#00000000"
    android:outlineSpotShadowColor="#242E3856"
    app:cardBackgroundColor="@color/sf_bg_surface"
    app:cardCornerRadius="18dp"
    app:cardElevation="4dp"
    app:cardPreventCornerOverlap="false"
    app:rippleColor="#124255FF"
    app:strokeColor="@color/sf_stroke_card"
    app:strokeWidth="1dp"
    tools:targetApi="p">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingVertical="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_search_set_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:text="Phrasal Verbs"
                android:textColor="@color/sf_text_primary"
                android:textSize="16.5sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/iv_search_set_has_image"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="8dp"
                android:contentDescription="Có hình ảnh"
                android:src="@drawable/ic_gallery"
                android:visibility="gone"
                app:tint="@color/sf_text_secondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_search_set_terms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:fontFamily="@font/plus_jakarta_sans_semibold"
            android:text="177 thuật ngữ"
            android:textColor="@color/sf_text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_search_set_avatar"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/bg_circle_avatar"
                android:gravity="center"
                android:text="O"
                android:textColor="@color/white"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_search_set_author"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="oguz57"
                android:textColor="@color/sf_text_primary"
                android:textSize="13.5sp" />
        </LinearLayout>

        <!-- Action Row: In All Results compact Study on bottom-right; in Sets tab Preview + Study -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_search_set_preview"
                style="@style/Widget.Material3.Button.UnelevatedButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:backgroundTint="@color/sf_bg_surface_alt"
                android:fontFamily="sans-serif-medium"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Xem trước"
                android:textAllCaps="false"
                android:textColor="@color/sf_text_primary"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:cornerRadius="19dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_search_set_study"
                style="@style/Widget.Material3.Button.UnelevatedButton"
                android:layout_width="144dp"
                android:layout_height="36dp"
                android:backgroundTint="@color/quizlet_blue"
                android:fontFamily="sans-serif-medium"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Học"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="13.5sp"
                android:textStyle="bold"
                app:cornerRadius="18dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
