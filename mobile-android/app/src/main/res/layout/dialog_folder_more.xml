<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_white"
    android:orientation="vertical"
    android:paddingBottom="20dp">

    <View
        android:layout_width="42dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="10dp"
        android:background="#94A3B8" />

    <LinearLayout
        android:id="@+id/row_folder_more_add"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="Thêm tài liệu học"
            android:src="@drawable/ic_nav_add"
            app:tint="@color/sf_text_secondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:fontFamily="@font/plus_jakarta_sans_semibold"
            android:text="Thêm tài liệu học"
            android:textColor="@color/sf_text_secondary"
            android:textSize="15.5sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_folder_more_tag"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="Thêm thẻ"
            android:src="@drawable/ic_folder_outline"
            app:tint="@color/sf_text_secondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:fontFamily="@font/plus_jakarta_sans_semibold"
            android:text="Thêm thẻ"
            android:textColor="@color/sf_text_secondary"
            android:textSize="15.5sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_folder_more_edit"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="Chỉnh sửa"
            android:src="@drawable/ic_edit"
            app:tint="@color/sf_text_secondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:fontFamily="@font/plus_jakarta_sans_semibold"
            android:text="Chỉnh sửa"
            android:textColor="@color/sf_text_secondary"
            android:textSize="15.5sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_folder_more_share"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="Chia sẻ"
            android:src="@drawable/ic_globe"
            app:tint="@color/sf_text_secondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:fontFamily="@font/plus_jakarta_sans_semibold"
            android:text="Chia sẻ"
            android:textColor="@color/sf_text_secondary"
            android:textSize="15.5sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_folder_more_delete"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="Xóa"
            android:src="@drawable/ic_close"
            app:tint="#DC2626" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:fontFamily="@font/plus_jakarta_sans_semibold"
            android:text="Xóa"
            android:textColor="#DC2626"
            android:textSize="15.5sp" />
    </LinearLayout>
</LinearLayout>
